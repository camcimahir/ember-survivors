# Copy this file to android/keystore.properties and fill in your own values.
# keystore.properties is gitignored - never commit it or the .jks file.
#
# Create the keystore first (once, and keep it forever - you cannot update a
# Play Store listing that was signed with a different key):
#
#   keytool -genkey -v -keystore ember-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias ember
#
storeFile=../ember-release.jks
storePassword=CHANGE_ME
keyAlias=ember
keyPassword=CHANGE_ME
